discovery.docker "linux" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "keep_logs" {
  targets = discovery.docker.linux.targets

  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = "eshop"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_port_public"]
    regex         = ".+"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "catalogapi|log-collector|lgtm"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.keep_logs.output
  labels     = {}
  forward_to = [loki.write.lgtm.receiver]
}

loki.write "lgtm" {
  endpoint {
    url = "http://lgtm:3100/loki/api/v1/push"
  }
}
