discovery.kubernetes "pods" {
  role = "pod"

  namespaces {
    names = ["catalog", "search", "viewer"]
  }
}

discovery.relabel "keep_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "catalog|search|viewer"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex         = "catalogapi|log-collector|lgtm"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "container"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.keep_logs.output
  forward_to = [loki.write.lgtm.receiver]
}

loki.write "lgtm" {
  endpoint {
    url = "http://lgtm.viewer.svc:3100/loki/api/v1/push"
  }
}
